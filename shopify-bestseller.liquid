{% assign picks = section.settings.collection %}
{% if picks != blank and picks.products_count > 0 %}
  {% assign heading = 'Ausgewählte Stücke' %}
  {% if section.settings.sales_label and picks.default_sort_by == 'best-selling' %}
    {% assign heading = 'Bestseller' %}
  {% endif %}

  <section class="aloue-picks" aria-labelledby="aloue-picks-{{ section.id }}">
    <header class="aloue-picks__heading">
      <h2 id="aloue-picks-{{ section.id }}">{{ heading }}</h2>
      <a href="{{ picks.url }}">Gesamtes Sortiment <span aria-hidden="true">→</span></a>
    </header>
    <ul class="aloue-picks__list" role="list">
      {% for product in picks.products limit: 3 %}
        <li>
          <a class="aloue-picks__card" href="{{ product.url }}">
            {% if product.featured_image %}
              {% assign image_alt = product.featured_image.alt | default: product.title %}
              <div class="aloue-picks__media">
                {{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 480, 660, 900', sizes: '(min-width: 760px) 32vw, 72vw', alt: image_alt, loading: 'lazy' }}
              </div>
            {% endif %}
            <div class="aloue-picks__info">
              <h3>{{ product.title | escape }}</h3>
              <span>{% if product.price_varies %}Ab {% endif %}{{ product.price | money }}</span>
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
{% elsif request.design_mode %}
  <p class="aloue-picks">Wähle eine Kollektion mit Produkten aus.</p>
{% endif %}

{% stylesheet %}
  .aloue-picks {
    width: calc(100% - 2 * clamp(1rem, 3.1vw, 3.5rem));
    max-width: 1420px;
    margin-inline: auto;
    padding-block: clamp(2.75rem, 5.5vw, 5.75rem);
  }
  .aloue-picks__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .6rem 1.25rem;
    margin-bottom: clamp(1.35rem, 3vw, 2.45rem);
  }
  .aloue-picks__heading h2 {
    font-size: clamp(2.6rem, 5.45vw, 5.6rem);
    line-height: 1.06;
    margin: 0;
  }
  .aloue-picks__heading a {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid #d9d2c7;
  }
  .aloue-picks__heading a:hover { border-color: currentColor; }
  .aloue-picks__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.9rem, 2.15vw, 2rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .aloue-picks__card { display: block; color: inherit; text-decoration: none; }
  .aloue-picks__media {
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e8e1d6;
    border-radius: 10px;
  }
  .aloue-picks__media img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .aloue-picks__info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .3rem .85rem;
    margin-top: .85rem;
  }
  .aloue-picks__info h3 { margin: 0; font-size: 1rem; }
  @media (max-width: 600px) {
    .aloue-picks__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(72vw, 17rem);
      overflow-x: auto;
      padding: .25rem .25rem .7rem;
      margin-inline: -.25rem;
      scroll-snap-type: x mandatory;
    }
    .aloue-picks__list > li { scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ALOUÉ Bestseller",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion",
      "info": "Stelle die Standardsortierung dieser Kollektion in Shopify auf Bestseller."
    },
    {
      "type": "checkbox",
      "id": "sales_label",
      "label": "Überschrift Bestseller anzeigen",
      "info": "Aktiviere das Label, sobald echte Bestellungen vorliegen.",
      "default": false
    }
  ],
  "presets": [{ "name": "ALOUÉ Bestseller" }]
}
{% endschema %}
